.venv/
__pycache__/
*.pyc
build/
dist/
*.spec
.private/
*.log
.env*
# Secrets / credentials — never commit (note: no broad `token*` rule on
# purpose; legitimate modules like `token_format.py` must stay committable).
*.key
*.pem
*.p12
*.pfx
credentials*.json
secrets*.json
# Local runtime databases, including user-owned workbench records.
workbench.sqlite3*
*.db-wal
*.db-shm
*.db-journal
